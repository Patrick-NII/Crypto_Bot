# =============================================================================
# OKAMOEY TRADING PLATFORM - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- General ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=okamoey
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=okamoey_trading

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth Service ---
AUTH_SERVICE_PORT=8001
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Portfolio Service ---
PORTFOLIO_SERVICE_PORT=8002

# --- Market Data Service ---
MARKET_DATA_SERVICE_PORT=8003
COINGECKO_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Trading Engine ---
TRADING_ENGINE_PORT=8004
CCXT_EXCHANGE=binance
TRADING_MODE=paper

# --- Risk Service ---
RISK_SERVICE_PORT=8005
MAX_PORTFOLIO_DRAWDOWN=0.15
DEFAULT_STOP_LOSS_PCT=0.05

# --- ML Service ---
ML_SERVICE_PORT=8006

# --- Notification Service ---
NOTIFICATION_SERVICE_PORT=8007
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- API Gateway ---
GATEWAY_PORT=8000
